          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Risk Veto Rate",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(trading_risk_vetoes_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Orders / Fills",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(trading_orders_total[5m]))",
          "legendFormat": "orders {{status}}"
        },
        {
          "expr": "sum(rate(trading_fills_total[5m]))",
          "legendFormat": "fills"
        }
      ]
    },
    {
      "type": "timeseries",
